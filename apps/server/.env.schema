# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# @public @type=port
PORT=3000

# HS256 signing secret, at least 32 characters. Generate with: openssl rand -base64 48
# @type=string(minLength=32)
JWT_SECRET=

# Token and cookie lifetime: <number><s|m|h|d>
# @public @type=string
JWT_EXPIRES_IN=8h

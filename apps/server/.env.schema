# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# @public @type=port
PORT=3000

# HS256 signing secret, at least 32 characters. Generate with: openssl rand -base64 48
# @type=string(minLength=32)
JWT_SECRET=

# Token and cookie lifetime: <number><s|m|h|d>
# @public @type=string
JWT_EXPIRES_IN=8h

# OpenAI API key used by the chat agent
# @type=string(minLength=1)
OPENAI_API_KEY=

# Chat Completions model with tool calling, e.g. gpt-4.1-mini
# @public @type=string(minLength=1)
LLM_MODEL=

# Maximum LLM calls per chat message (tool-calling loop cap)
# @public @type=number(min=2, max=10, isInt=true)
AGENT_MAX_ITERATIONS=5
